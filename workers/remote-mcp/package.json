{
  "name": "@frihet/remote-mcp-server",
  "version": "1.1.0",
  "description": "Remote MCP server for Frihet ERP on Cloudflare Workers (OAuth 2.0 + PKCE)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix ../.. run gate:analytics && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test 'src/__tests__/*.test.ts' 'src/__tests__/*.test.mjs'"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "0.7.5",
    "firebase-auth-cloudflare-workers": "^2.0.6",
    "hono": "~4.12.34",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250306.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.67.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "@hono/node-server": "2.0.12",
      "hono": "~4.12.34"
    },
    "agents": {
      "@modelcontextprotocol/sdk": "1.30.0"
    }
  }
}
