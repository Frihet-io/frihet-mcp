{
  "schemaVersion": 1,
  "workerName": "frihet-remote-mcp",
  "status": "pending-bootstrap",
  "targetTopology": {
    "entrypoint": "src/index.ts",
    "compatibilityDate": "2025-12-01",
    "compatibilityFlags": [
      "nodejs_compat"
    ],
    "routes": [
      {
        "pattern": "mcp.frihet.io/*",
        "zoneName": "frihet.io"
      }
    ],
    "migrations": [
      {
        "tag": "v1",
        "newSqliteClasses": [
          "FrihetMCP"
        ]
      },
      {
        "tag": "v2",
        "newSqliteClasses": [
          "OAuthStateStore"
        ]
      }
    ],
    "migrationTag": "v2",
    "durableObjects": [
      {
        "binding": "MCP_OBJECT",
        "className": "FrihetMCP"
      },
      {
        "binding": "OAUTH_STATE",
        "className": "OAuthStateStore"
      }
    ],
    "kvNamespaces": [
      {
        "binding": "OAUTH_KV",
        "namespaceId": "9207b98598f849109139ad11f3b0ac51"
      }
    ],
    "assets": {
      "binding": "ASSETS",
      "directory": "./public"
    },
    "vars": {
      "FRIHET_OPENAI_MODE": "false",
      "FRIHET_TOOL_MODE": "grouped"
    }
  },
  "baseline": null,
  "recovery": {
    "strategy": "forward-only"
  }
}
