    "taskSupport": "forbidden"
  },
  "_meta": {
    "io.frihet/capability": {
      "registered": true,
      "callability": "api_dependent",
      "canonicalOperation": "list_transactions",
      "writesFrihet": false,
      "externalInteraction": false,
      "externalSideEffects": []
    }
  }
}
