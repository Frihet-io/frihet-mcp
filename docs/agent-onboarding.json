        "effects": [
          "external_provider_read"
        ]
      },
      {
        "tool": "gestoria_message_send",
        "effects": [
          "email_or_invitation"
        ]
      },
      {
        "tool": "gestoria_template_bulk_send",
        "effects": [
          "email_or_invitation"
        ]
      },
      {
        "tool": "invite_team_member",
        "effects": [
          "email_or_invitation"
        ]
      },
      {
        "tool": "refund_sale",
        "effects": [
          "money_movement"
        ]
      },
      {
        "tool": "send_einvoice",
        "effects": [
          "fiscal_or_einvoice_submission"
        ]
      },
      {
        "tool": "send_invoice",
        "effects": [
