    {
      "name": "Invoices",
      "item": [
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Get Invoice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices/{{invoiceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "{{invoiceId}}"]
            }
          }
        },
        {
          "name": "Create Draft Invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientName\": \"Acme Global SL\",\n  \"clientTaxId\": \"B12345678\",\n  \"clientLocation\": \"peninsula\",\n  \"taxRate\": 21,\n  \"items\": [\n    {\n      \"description\": \"Consulting Services\",\n      \"quantity\": 1,\n      \"unitPrice\": 150.00\n    }\n  ],\n  \"notes\": \"Reviewable draft invoice.\",\n  \"status\": \"draft\",\n  \"provisionalDraft\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"Invoice is strictly in draft status\", function () {",
                  "    var json = pm.response.json();",
                  "    var record = json.data || json;",
                  "    pm.expect(record.status).to.eql('draft');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Credit Note Draft",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
