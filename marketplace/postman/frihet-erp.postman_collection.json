{
  "info": {
    "name": "Frihet ERP API v1 Collection",
    "_postman_id": "7b2e8f1c-4e31-412f-90e1-f673190b2026",
    "description": "Official Postman collection for the Frihet ERP REST API v1 (https://api.frihet.io/v1). Covers business intelligence, global search, invoices, quotes, expenses, clients, products, vendors, deposits, banking & reconciliation, Spanish/EU fiscal & e-invoicing (VeriFactu, FACe, TicketBAI, Facturae/EN 16931), POS, Stay PMS, Kitchen KDS, webhooks, team, and gestoría. Uses canonical X-API-Key authentication, UUIDv4 Idempotency-Key headers on mutations, and draft-only document creation invariants.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Intelligence, Summaries & Global Search",
      "item": [
        {
          "name": "Get Business Context",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/context",
              "host": ["{{baseUrl}}"],
              "path": ["context"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response contains operating context\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
