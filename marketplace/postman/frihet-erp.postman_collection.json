{
  "info": {
    "name": "Frihet ERP API",
    "_postman_id": "c1f7b8e2-04e1-4c6e-8e4a-4a69b72019a1",
    "description": "Official Postman Collection for Frihet ERP — AI-native business management, invoicing, expenses, and European tax compliance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Context & Taxes",
      "item": [
        {
          "name": "Get Business Context",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/context",
              "host": ["{{baseUrl}}"],
              "path": ["context"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Has valid business context\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Monthly Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/summaries/monthly?year=2026&month=10",
              "host": ["{{baseUrl}}"],
              "path": ["summaries", "monthly"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "month", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Quarterly Taxes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/taxes/quarterly?year=2026&quarter=3",
              "host": ["{{baseUrl}}"],
              "path": ["taxes", "quarterly"],
              "query": [
                { "key": "year", "value": "2026" },
                { "key": "quarter", "value": "3" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "List Invoices",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/invoices?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Create Draft Invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"client_sample_123\",\n  \"items\": [\n    {\n      \"description\": \"Consulting Services\",\n      \"quantity\": 1,\n      \"unitPrice\": 150.00,\n      \"vatRate\": 21\n    }\n  ],\n  \"notes\": \"Reviewable draft invoice.\",\n  \"status\": \"draft\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/invoices",
              "host": ["{{baseUrl}}"],
              "path": ["invoices"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test(\"Invoice is strictly in draft status\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('draft');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "List Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Create Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vendor\": \"Cloud Services Corp\",\n  \"amount\": 49.99,\n  \"vatRate\": 21,\n  \"category\": \"Software\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"]
            }
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clients?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["clients"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Create Client",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Global Inc\",\n  \"taxId\": \"B12345678\",\n  \"email\": \"billing@acmeglobal.com\",\n  \"country\": \"ES\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": ["{{baseUrl}}"],
              "path": ["clients"]
            }
          }
        }
      ]
    }
  ]
}
